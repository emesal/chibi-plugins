# /// script
# requires-python = ">=3.11"
# dependencies = []
# ///
"""
Deny-only security gate for file write operations.

Example plugin demonstrating the deny-only permission protocol. Plugins
return {"denied": true, "reason": "..."} to block an operation, or {}
(no opinion) to let it fall through to the frontend's default handler
(e.g. interactive TTY prompt).

This example denies writes to paths outside the project root.
Customise the deny logic for your own security requirements.
"""

import json
import os
import sys

SCHEMA = {
    "name": "file_permission",
    "description": "deny-only security gate for file writes (example plugin)",
    "parameters": {"type": "object", "properties": {}, "required": []},
    "hooks": ["pre_file_write"],
}


def main():
    if len(sys.argv) > 1 and sys.argv[1] == "--schema":
        print(json.dumps(SCHEMA))
        return

    hook = os.environ.get("CHIBI_HOOK")
    if hook != "pre_file_write":
        # not our hook — no opinion
        print("{}")
        return

    hook_data = json.load(sys.stdin)
    path = os.path.realpath(hook_data.get("path", ""))
    project_root = os.environ.get("CHIBI_PROJECT_ROOT", "")

    # deny writes outside the project root (if set)
    if project_root and not path.startswith(os.path.realpath(project_root)):
        print(json.dumps({
            "denied": True,
            "reason": f"path '{path}' is outside project root '{project_root}'",
        }))
        return

    # no objection — falls through to frontend handler
    print("{}")


if __name__ == "__main__":
    main()
